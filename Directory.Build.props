<Project><PropertyGroup>
  <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion>
  <TreatWarningsAsErrors>true</TreatWarningsAsErrors><AnalysisLevel>latest-recommended</AnalysisLevel><Deterministic>true</Deterministic>
  <VersionPrefix>0.1.0</VersionPrefix><VersionSuffix>preview.1</VersionSuffix><Authors>Ilhan Emir</Authors>
  <RepositoryUrl>https://github.com/hanzales/mcp-guardian-runtime</RepositoryUrl><RepositoryType>git</RepositoryType>
</PropertyGroup></Project>
